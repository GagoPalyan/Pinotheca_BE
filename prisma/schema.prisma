generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())

  firstname   String
  lastname    String

  email       String   @unique
  password    String   @map("password_hash")

  isAdmin     Boolean  @default(false) @map("is_admin")

  likes       Like[]
  followers   Follower[]
  orders      Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at") 

  @@map("users")
}

model Picture {
  id  String @id @default(uuid())

  url         String
  title       String
  description String

  width       Int
  height      Int

  material   String
  paint   String
  type    String

  price       Float
  isSold      Boolean  @default(false) @map("is_sold")

  likes       Like[]
  orders      Order[]
  author      Author  @relation(fields: [authorId], references: [id])
  authorId    String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pictures")
}

model Author {
  id  String @id @default(uuid())

  firstname   String
  lastname    String

  about       String
  imageUrl    String  @map("image_url")

  pictures Picture[]
  followers   Follower[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("authors")
}

model Like {
  id         String   @id @default(uuid())
  
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  
  picture    Picture  @relation(fields: [pictureId], references: [id])
  pictureId  String

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, pictureId])

  @@map("likes")
}

model Follower {
  id String   @id @default(uuid())

  user User     @relation(fields: [userId], references: [id])
  userId String

  author Author @relation(fields: [authorId], references: [id])
  authorId String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, authorId])

  @@map("followers")
}

model Order {
  id         String @id @default(uuid())

  user User  @relation(fields: [userId], references: [id])
  userId String

  picture Picture @relation(fields: [pictureId], references: [id])
  pictureId String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime @map("deleted_at")

  @@map("orders")
}